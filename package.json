{
  "name": "gease-visual-shell",
  "version": "3.72.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "verify:schema-real": "node scripts/verify-real-schema.mjs",
    "verify:syntax": "node scripts/verify-syntax.mjs",
    "verify:contracts": "node scripts/verify-business-contracts.mjs",
    "verify:all": "npm run verify:schema-real && npm run verify:catalogs && npm run verify:syntax && npm run verify:contracts && npm run verify:focus-stability && npm run verify:navigation && npm run verify:config-pages",
    "verify:catalogs": "node scripts/verify-canonical-catalogs.mjs",
    "verify:focus-stability": "node scripts/verify-focus-stability.mjs",
    "verify:navigation": "node scripts/verify-navigation-structure.mjs",
    "verify:config-pages": "node scripts/verify-config-pages.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@10.9.2"
}
