# CRM/Vercel STAGING — exemplo sem credenciais reais.
# Copie para .env.staging apenas no ambiente local seguro ou configure os mesmos
# nomes no escopo Preview/Staging da Vercel. Nunca reutilize valores de produção.

# Metadados usados somente pelo preflight local.
STAGING_ENVIRONMENT_NAME=staging
STAGING_CRM_URL=https://crm-staging.example.invalid
STAGING_SUPABASE_PROJECT_REF=staging-project-ref
PRODUCTION_SUPABASE_PROJECT_REF_FOR_COMPARISON=production-project-ref
PRODUCTION_SUPABASE_HOST_FOR_COMPARISON=production-project-ref.supabase.co
STAGING_WORKER_URL=https://worker-staging.example.invalid
PRODUCTION_WORKER_HOST_FOR_COMPARISON=worker-production.example.invalid
STAGING_EVOLUTION_URL=https://evolution-staging.example.invalid
PRODUCTION_EVOLUTION_HOST_FOR_COMPARISON=evolution-production.example.invalid
STAGING_INSTAGRAM_ACCOUNT_USERNAME=replace-with-controlled-instagram-account
STAGING_INSTAGRAM_RECIPIENT_USERNAME=replace-with-controlled-instagram-recipient
STAGING_TEST_WHATSAPP_E164=replace-with-authorized-brazilian-e164
STAGING_USER_A_EMAIL=usuario-a-staging@example.invalid
STAGING_USER_B_EMAIL=usuario-b-staging@example.invalid

# Frontend Vite: valores públicos do projeto Supabase exclusivo de staging.
VITE_SUPABASE_URL=https://staging-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
VITE_WHATSAPP_WORKER_DISPATCH_ENDPOINT=/api/whatsapp/dispatch
VITE_RECONCILIATION_STALE_MINUTES=45

# APIs serverless da Vercel: nunca prefixar secrets com VITE_.
SUPABASE_URL=https://staging-project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-staging-anon-key
SUPABASE_PUBLISHABLE_KEY=replace-with-staging-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-staging-service-role-key

# Worker privado de staging. Os tokens devem ser iguais a WORKER_HTTP_TOKEN.
WHATSAPP_VALIDATION_WORKER_URL=https://worker-staging.example.invalid
WHATSAPP_VALIDATION_WORKER_TOKEN=replace-with-random-staging-token-min-32-chars
WHATSAPP_VALIDATION_TIMEOUT_MS=30000
WHATSAPP_WORKER_BATCH_URL=https://worker-staging.example.invalid/batch/whatsapp
WHATSAPP_WORKER_BATCH_TOKEN=replace-with-random-staging-token-min-32-chars

# Assinaturas exclusivas de staging, ambas com no mínimo 32 caracteres.
INSTAGRAM_EXTENSION_SIGNING_SECRET=replace-with-random-staging-signing-secret
EVOLUTION_WEBHOOK_SECRET=replace-with-random-staging-webhook-secret

# Compatibilidade documentada; o endpoint direto está descontinuado e não deve
# apontar para o Worker.
# VITE_WHATSAPP_WORKER_VALIDATE_ENDPOINT=/api/whatsapp/validate
# VITE_WHATSAPP_WORKER_REVALIDATE_ENDPOINT=/api/whatsapp/revalidate
# WHATSAPP_WORKER_DISPATCH_URL=
# WHATSAPP_WORKER_DISPATCH_TOKEN=
