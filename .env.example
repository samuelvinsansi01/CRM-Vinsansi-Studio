# CRM - Vinsansi Studio v1.1.0 — exemplo de ambiente
# Nunca coloque credenciais reais neste arquivo.
# O schema desta versao e fixo: users, leads, queues, queue_items, chips,
# instances, levels, socials, templates, branches, status e sents.

# ---------------------------------------------------------------------------
# Frontend (variaveis publicas Vite)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

VITE_WHATSAPP_WORKER_VALIDATE_ENDPOINT=/api/whatsapp/validate
VITE_WHATSAPP_WORKER_REVALIDATE_ENDPOINT=/api/whatsapp/revalidate
VITE_RECONCILIATION_STALE_MINUTES=45

# ---------------------------------------------------------------------------
# Backend/serverless do painel — privadas, sem prefixo VITE_
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# A validação WhatsApp usa o control plane persistente (Supabase -> Worker local).
# Não há URL/token de Worker de validação no CRM hospedado.

# A URL abaixo deve terminar em /batch/whatsapp.
WHATSAPP_WORKER_BATCH_URL=https://SEU-WORKER/batch/whatsapp
WHATSAPP_WORKER_BATCH_TOKEN=
WHATSAPP_WORKER_BATCH_TIMEOUT_MS=15000

# Assinatura temporaria da extensao Instagram. Use no minimo 32 caracteres.
INSTAGRAM_EXTENSION_SIGNING_SECRET=

# Assinatura temporária da extensão Google Maps. Exclusiva do backend/Vercel.
# Nunca prefixar com VITE_ nem incluir no pacote da extensão.
# Mínimo de 32 caracteres após trim; não exige Base64 ou hexadecimal.
GMAPS_EXTENSION_SIGNING_SECRET=
PUBLIC_APP_URL=https://painel.samuelvinsansi.com.br
# Usada também no redirecionamento de convites de membros. Pode repetir PUBLIC_APP_URL.
APP_PUBLIC_URL=https://painel.samuelvinsansi.com.br

# ---------------------------------------------------------------------------
# Sincronização automática Evolution API
# ---------------------------------------------------------------------------
# Configure como secret do projeto Supabase. Use no mínimo 32 caracteres aleatórios.
# A assinatura é enviada em header; não inclua este valor em URLs.
EVOLUTION_WEBHOOK_SECRET=
