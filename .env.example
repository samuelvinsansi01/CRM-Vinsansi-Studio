# Lead Certo V2 - exemplo de ambiente
# Nunca coloque valores reais neste arquivo.

# ---------------------------------------------------------------------------
# Frontend / Vercel - somente variaveis publicas
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legado opcional: use somente se o projeto ainda estiver com anon key antiga.
VITE_SUPABASE_ANON_KEY=

# Endpoint interno/backend do Worker. Nao deve expor Evolution diretamente.
VITE_WHATSAPP_WORKER_DISPATCH_ENDPOINT=
VITE_WHATSAPP_WORKER_VALIDATE_ENDPOINT=/api/whatsapp/validate
VITE_WHATSAPP_WORKER_REVALIDATE_ENDPOINT=/api/whatsapp/revalidate

# Politica para numero de WhatsApp invalido: review (segura, padrao) ou instagram (legado).
VITE_WHATSAPP_INVALID_ACTION=review

# Flags dos repositories reais no frontend.
VITE_USE_SUPABASE_CONFIG=true
VITE_USE_SUPABASE_IMPORT=true
VITE_USE_SUPABASE_BASE=true
VITE_USE_SUPABASE_SETTINGS=true
VITE_USE_SUPABASE_PRE_SEND=true
VITE_USE_SUPABASE_WHATSAPP_QUEUE=true
VITE_USE_SUPABASE_INSTAGRAM_QUEUE=true

# Contrato canonico de tabelas. Nao preencha se usar os nomes abaixo.
VITE_SUPABASE_TABLE_CHIPS=chips
VITE_SUPABASE_TABLE_INSTAGRAM_PROFILES=instagram_profiles
VITE_SUPABASE_TABLE_BRANCHES=branches
VITE_SUPABASE_TABLE_TEMPLATES=templates
VITE_SUPABASE_TABLE_IMPORT_LEADS=leads
VITE_SUPABASE_TABLE_PRE_SEND_LEADS=pre_send_leads
VITE_SUPABASE_TABLE_WHATSAPP_QUEUE_ITEMS=whatsapp_queue_items
VITE_SUPABASE_TABLE_INSTAGRAM_QUEUE_ITEMS=instagram_queue_items
VITE_SUPABASE_TABLE_EVENTS=lead_events
VITE_SUPABASE_TABLE_SETTINGS=app_settings
VITE_SUPABASE_TABLE_IMPORT_BATCHES=import_batches
VITE_SUPABASE_TABLE_LEAD_IMPORTS=lead_imports
VITE_SUPABASE_TABLE_LEAD_REGISTRY=lead_registry
VITE_SUPABASE_TABLE_DISPATCH_MESSAGE_LOGS=lead_dispatch_messages

# Flags publicas de canais.
VITE_WHATSAPP_ENABLED=true
VITE_INSTAGRAM_ENABLED=true

# Fallback temporario somente para ambiente local/teste sem auth real.
# Em producao com login Supabase, deixe vazio.
VITE_DEFAULT_USER_ID=

# Defaults operacionais publicos usados pelo painel.
VITE_DEFAULT_BATCH_SIZE=40
VITE_DEFAULT_BATCH_DELAY_SECONDS=120
VITE_DEFAULT_LEAD_DELAY_SECONDS=120
VITE_DELAY_MSG1_TO_MSG2_SECONDS=120
VITE_DELAY_MSG2_TO_IMAGE_SECONDS=120

# ---------------------------------------------------------------------------
# Worker / Backend - variaveis privadas, nunca cadastrar como VITE_*
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


USE_EVOLUTION=true
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_PREFIX=chip-
EVOLUTION_MESSAGE_DELAY_MS=1200
EVOLUTION_VALIDATION_DELAY_MS=0
EVOLUTION_VALIDATION_BATCH_SIZE=50

WORKER_TEST_MODE=false
TEST_PHONE=
DRY_RUN=false

# Versão do contrato de banco utilizado pelo frontend.
VITE_DATABASE_SCHEMA_VERSION=v2

# Preflight opcional do Worker Docker antes de consultar a Evolution.
# Quando required=true e o Worker estiver indisponivel, nenhum lead do lote e alterado.
WHATSAPP_VALIDATION_REQUIRE_WORKER_HEALTH=false
WHATSAPP_VALIDATION_WORKER_HEALTH_URL=
WHATSAPP_VALIDATION_WORKER_HEALTH_TOKEN=
WHATSAPP_VALIDATION_HEALTH_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# F07 - proxy privado para lotes e disparos WhatsApp
# O navegador chama somente /api/whatsapp/batch e /api/whatsapp/dispatch.
# ---------------------------------------------------------------------------
SUPABASE_ANON_KEY=
WHATSAPP_WORKER_BATCH_URL=https://SEU-WORKER/batch/whatsapp
WHATSAPP_WORKER_BATCH_TOKEN=O_MESMO_VALOR_DE_WORKER_HTTP_TOKEN
WHATSAPP_WORKER_BATCH_TIMEOUT_MS=15000
WHATSAPP_WORKER_DISPATCH_URL=https://SEU-WORKER/dispatch/whatsapp
WHATSAPP_WORKER_DISPATCH_TOKEN=O_MESMO_VALOR_DE_WORKER_HTTP_TOKEN
WHATSAPP_WORKER_DISPATCH_TIMEOUT_MS=55000

# ---------------------------------------------------------------------------
# F08 - vínculo temporário da extensão Instagram
# Somente backend. Não use prefixo VITE_.
# ---------------------------------------------------------------------------
INSTAGRAM_EXTENSION_SIGNING_SECRET=
SUPABASE_TABLE_INSTAGRAM_QUEUE_ITEMS=instagram_queue_items
SUPABASE_TABLE_IMPORT_LEADS=leads

# F10 - minutos sem atualização para considerar item operacional travado.
VITE_RECONCILIATION_STALE_MINUTES=45
