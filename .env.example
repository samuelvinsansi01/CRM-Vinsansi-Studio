# Painel CRM — exemplo de ambiente
# Nunca coloque credenciais reais neste arquivo.

# ---------------------------------------------------------------------------
# Frontend (variáveis públicas Vite)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Tabelas do banco novo. Mantenha os padrões quando os nomes físicos forem estes.
VITE_SUPABASE_TABLE_CHIPS=chips
VITE_SUPABASE_TABLE_INSTAGRAM_PROFILES=instagram_profiles
VITE_SUPABASE_TABLE_BRANCHES=branches
VITE_SUPABASE_TABLE_TEMPLATES=templates
VITE_SUPABASE_TABLE_IMPORT_LEADS=leads
VITE_SUPABASE_TABLE_WHATSAPP_QUEUE_ITEMS=whatsapp_queue_items
VITE_SUPABASE_TABLE_INSTAGRAM_QUEUE_ITEMS=instagram_queue_items
VITE_SUPABASE_TABLE_EVENTS=lead_events
VITE_SUPABASE_TABLE_SETTINGS=app_settings
VITE_SUPABASE_TABLE_DISPATCH_MESSAGE_LOGS=lead_dispatch_messages

# Rotas internas do próprio painel.
VITE_WHATSAPP_WORKER_VALIDATE_ENDPOINT=/api/whatsapp/validate
VITE_WHATSAPP_WORKER_REVALIDATE_ENDPOINT=/api/whatsapp/revalidate
VITE_WHATSAPP_WORKER_DISPATCH_ENDPOINT=/api/whatsapp/dispatch

# F10: tempo sem atualização para considerar uma operação travada.
VITE_RECONCILIATION_STALE_MINUTES=45

# ---------------------------------------------------------------------------
# Backend/serverless do painel — variáveis privadas, sem prefixo VITE_
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tabelas usadas pelas rotas serverless.
SUPABASE_TABLE_WHATSAPP_QUEUE_ITEMS=whatsapp_queue_items
SUPABASE_TABLE_INSTAGRAM_QUEUE_ITEMS=instagram_queue_items
SUPABASE_TABLE_IMPORT_LEADS=leads

# Worker WhatsApp privado.
WHATSAPP_VALIDATION_WORKER_URL=https://SEU-WORKER
WHATSAPP_VALIDATION_WORKER_TOKEN=
WHATSAPP_VALIDATION_TIMEOUT_MS=30000
WHATSAPP_WORKER_BATCH_URL=https://SEU-WORKER/batch/whatsapp
WHATSAPP_WORKER_BATCH_TOKEN=
WHATSAPP_WORKER_BATCH_TIMEOUT_MS=15000
WHATSAPP_WORKER_DISPATCH_URL=https://SEU-WORKER/dispatch/whatsapp
WHATSAPP_WORKER_DISPATCH_TOKEN=
WHATSAPP_WORKER_DISPATCH_TIMEOUT_MS=55000

# Compatibilidade opcional de endpoint/health do Worker.
WHATSAPP_VALIDATION_WORKER_HEALTH_URL=
WHATSAPP_VALIDATION_WORKER_HEALTH_TOKEN=
WHATSAPP_VALIDATION_HEALTH_TIMEOUT_MS=8000

# Assinatura temporária da extensão Instagram. Use no mínimo 32 caracteres.
INSTAGRAM_EXTENSION_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Supabase Edge Functions do Apify
# ---------------------------------------------------------------------------
# O Supabase fornece SUPABASE_URL automaticamente no ambiente das funções.
# Configure como secrets quando necessário:
# SUPABASE_ANON_KEY=
# SB_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
