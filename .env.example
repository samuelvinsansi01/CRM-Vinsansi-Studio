# CRM - Vinsansi Studio — ambiente central do Control Plane
# Nunca coloque credenciais reais neste arquivo de exemplo.

# ---------------------------------------------------------------------------
# Banco / Auth — ÚNICO ponto de credenciais Supabase para toda a plataforma
# ---------------------------------------------------------------------------
# CRM web, Gerenciador e Mobile descobrem a configuração pública em:
#   GET /api/system?route=public-config
# Gateway/Worker não precisam conhecer URL ou chave do Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Domínio estável do Control Plane. Este endereço não muda ao trocar de banco.
PUBLIC_APP_URL=https://painel.samuelvinsansi.com.br
APP_PUBLIC_URL=https://painel.samuelvinsansi.com.br

# ---------------------------------------------------------------------------
# Endpoints públicos do frontend
# ---------------------------------------------------------------------------
VITE_WHATSAPP_WORKER_VALIDATE_ENDPOINT=/api/whatsapp/validate
VITE_WHATSAPP_WORKER_REVALIDATE_ENDPOINT=/api/whatsapp/revalidate
VITE_RECONCILIATION_STALE_MINUTES=45

# ---------------------------------------------------------------------------
# Operação WhatsApp persistente
# ---------------------------------------------------------------------------
WHATSAPP_WORKER_BATCH_URL=https://SEU-WORKER/batch/whatsapp
WHATSAPP_WORKER_BATCH_TOKEN=
WHATSAPP_WORKER_BATCH_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Extensões
# ---------------------------------------------------------------------------
INSTAGRAM_EXTENSION_SIGNING_SECRET=
GMAPS_EXTENSION_SIGNING_SECRET=

# Assinatura de webhook da Evolution armazenada como secret do projeto Supabase.
EVOLUTION_WEBHOOK_SECRET=
