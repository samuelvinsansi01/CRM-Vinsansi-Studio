# Painel CRM v3.75.0 — exemplo de ambiente
# Nunca coloque credenciais reais neste arquivo.
# O schema desta versao e fixo: users, leads, queues, queue_items, chips,
# instances, levels, socials, templates, branches, status e sents.

# ---------------------------------------------------------------------------
# Frontend (variaveis publicas Vite)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

VITE_WHATSAPP_WORKER_VALIDATE_ENDPOINT=/api/whatsapp/validate
VITE_WHATSAPP_WORKER_REVALIDATE_ENDPOINT=/api/whatsapp/revalidate
VITE_WHATSAPP_WORKER_DISPATCH_ENDPOINT=/api/whatsapp/dispatch
VITE_RECONCILIATION_STALE_MINUTES=45

# ---------------------------------------------------------------------------
# Backend/serverless do painel — privadas, sem prefixo VITE_
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Worker WhatsApp privado.
WHATSAPP_VALIDATION_WORKER_URL=https://SEU-WORKER
WHATSAPP_VALIDATION_WORKER_TOKEN=
WHATSAPP_VALIDATION_TIMEOUT_MS=30000

# A URL abaixo deve terminar em /batch/whatsapp.
WHATSAPP_WORKER_BATCH_URL=https://SEU-WORKER/batch/whatsapp
WHATSAPP_WORKER_BATCH_TOKEN=
WHATSAPP_WORKER_BATCH_TIMEOUT_MS=15000

# A URL abaixo deve terminar em /dispatch/whatsapp.
WHATSAPP_WORKER_DISPATCH_URL=https://SEU-WORKER/dispatch/whatsapp
WHATSAPP_WORKER_DISPATCH_TOKEN=
WHATSAPP_WORKER_DISPATCH_TIMEOUT_MS=55000

# Assinatura temporaria da extensao Instagram. Use no minimo 32 caracteres.
INSTAGRAM_EXTENSION_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Supabase Edge Functions do Apify
# ---------------------------------------------------------------------------
# Configure como secrets no projeto Supabase quando necessario:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Sincronização automática Evolution API
# ---------------------------------------------------------------------------
# Configure como secret do projeto Supabase. Use no mínimo 32 caracteres.
EVOLUTION_WEBHOOK_SECRET=
